# Copie para supabase/.env.production (não vai para o Git) e preencha.
# Usado por scripts/deploy-supabase.sh.

# --- Projeto (Supabase > Project Settings) --------------------------------------
# Reference ID do projeto (General > Reference ID)
SUPABASE_PROJECT_REF=
# String de conexão do banco (Connect > Connection string > URI, modo "Session")
# Ex.: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- App ---------------------------------------------------------------------------
# Endereço público do app, sem barra no fim (ex.: https://balcao.app)
PUBLIC_APP_URL=
# Segredo que o agendador usa para chamar o envio de mensagens (gere um texto longo)
CRON_SECRET=

# --- E-mail (https://resend.com) ------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Balcão <nao-responda@seudominio.com>

# --- Meta (WhatsApp Cloud API e Instagram) ----------------------------------------------
# App Secret do app na Meta (Configurações > Básico); valida os webhooks. Opcional.
META_APP_SECRET=

# --- Cobrança: escolha stripe, asaas ou mercadopago ----------------------------------------
BILLING_PROVIDER=asaas

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_EMPRESA=

# Asaas (produção: https://api.asaas.com/v3 | testes: https://api-sandbox.asaas.com/v3)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
